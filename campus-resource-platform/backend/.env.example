# IBM Cloudant Credentials
CLOUDANT_URL=https://your-cloudant-instance.cloudantnosqldb.appdomain.cloud
CLOUDANT_APIKEY=your-api-key-here

# JWT Settings
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# App Settings
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# IBM Cloud Object Storage (optional)
COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
COS_API_KEY=your-cos-api-key
COS_INSTANCE_ID=your-cos-instance-id
COS_BUCKET_NAME=campus-resources
